# Copy to infra/.env, set chmod 600 on Linux, and replace every blank secret.
# The real .env is ignored by Git and must never be committed.

# PostgreSQL 16. This user owns the project database inside the private data network.
POSTGRES_DB=book_decision
POSTGRES_USER=book_decision_app
POSTGRES_PASSWORD=

# MinIO is not published on the host. The backend uses these credentials internally.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=book-decision-private-uploads

# Private CSV data is retained for 30 days unless the user deletes it earlier.
USER_DATASET_ENABLED=true
USER_DATASET_RETENTION_DAYS=30
USER_DATASET_MAX_RETAINED_UPLOADS=100
USER_DATASET_MAX_RETAINED_BYTES=52428800
USER_DATASET_RATE_LIMIT_MAX_UPLOADS=10
USER_DATASET_RATE_LIMIT_WINDOW_SECONDS=60

# Platform text display only: real (default) or alias. No third-party brand assets are used.
PLATFORM_DISPLAY_MODE=real

# Set false to remove the management API and page's backend capability.
# When true, both credentials below are mandatory.
# ADMIN_PASSWORD is BCrypt-encoded at startup and must not exceed 72 UTF-8 bytes.
ADMIN_API_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Conservative defaults for a 4-core / 4-GiB host.
SOLVER_WORKER_COUNT=1
SOLVER_MAX_CONCURRENT_REQUESTS=2
